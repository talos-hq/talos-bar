#!/bin/sh
# Refuses to push a branch head the local gate has not proven, then attests it
# to the repository being pushed to once the push lands. Installed by ./ci.py
# (core.hooksPath). The slow part is `./ci.py run`, run beforehand; this only
# checks its receipts, and re-runs any lane marked network = true.
root=$(git rev-parse --show-toplevel)
remote=$1
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref _; do
    [ "$local_sha" = "$zero" ] && continue
    case "$remote_ref" in refs/heads/*) ;; *) continue ;; esac
    if python3 "$root/ci.py" verify --sha "$local_sha" --remote "$remote"; then
        nohup python3 "$root/ci.py" attest --sha "$local_sha" --remote "$remote" --retries 24 >/dev/null 2>&1 &
    else
        status=1
    fi
done
exit $status
