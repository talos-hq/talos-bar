#!/usr/bin/env bash
# Local CI gate: nothing is pushed unless the exact tree passed `bosn run --task ci`.
# A passing tree is remembered, so re-pushing an unchanged tree does not re-run it.
# Enable once per clone: git config core.hooksPath .githooks
set -euo pipefail

zero=0000000000000000000000000000000000000000
head=$(git rev-parse HEAD)
gate=0
while read -r _ local_sha _ _; do
  [ "$local_sha" = "$zero" ] && continue # branch deletion
  gate=1
  if [ "$local_sha" != "$head" ]; then
    echo "local-ci: refusing push: $local_sha is not HEAD; check it out so it can be tested" >&2
    exit 1
  fi
done
[ "$gate" = 1 ] || exit 0

if [ -n "$(git status --porcelain)" ]; then
  echo "local-ci: refusing push: the tree is dirty, so the tested code would differ from the pushed code" >&2
  exit 1
fi

stamps="$(git rev-parse --git-common-dir)/local-ci-pass"
stamp="$stamps/$(git rev-parse 'HEAD^{tree}')"
if [ -e "$stamp" ]; then
  echo "local-ci: this tree already passed; skipping"
  exit 0
fi

bosn run --task ci
mkdir -p "$stamps"
touch "$stamp"
